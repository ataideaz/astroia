{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astroia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Configurações públicas (não são segredos). Segredos, como a credencial
  // do Mercado Pago, ficam só no painel da Cloudflare.
  "keep_vars": true,
  "vars": {
    "ASTROIA_SITE_URL": "https://astroia.ataideaz.workers.dev",
    "MERCADO_PAGO_MODE": "test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astroia",
      "database_id": "7d587457-b0d6-466b-835a-5ba88da28320",
      "migrations_dir": "drizzle"
    }
  ]
}
