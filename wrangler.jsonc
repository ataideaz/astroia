{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astroia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Domínio próprio (zona meuastroia.com.br na Cloudflare). O endereço
  // workers.dev continua ativo para os links antigos.
  "routes": [
    { "pattern": "meuastroia.com.br", "custom_domain": true },
    { "pattern": "www.meuastroia.com.br", "custom_domain": true }
  ],
  "workers_dev": true,
  // Configurações públicas (não são segredos). Segredos, como a credencial
  // do Mercado Pago, ficam só no painel da Cloudflare.
  "keep_vars": true,
  "vars": {
    "ASTROIA_SITE_URL": "https://meuastroia.com.br",
    "MERCADO_PAGO_MODE": "production",
    // Chave pública do Mercado Pago (feita para ficar no site; não é segredo).
    "MERCADO_PAGO_PUBLIC_KEY": "APP_USR-1b712c2c-6af0-4fc7-ad1d-9d2c34067889"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astroia",
      "database_id": "7d587457-b0d6-466b-835a-5ba88da28320",
      "migrations_dir": "drizzle"
    }
  ]
}
